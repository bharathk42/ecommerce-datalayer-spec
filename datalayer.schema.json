{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bharathk42/ecommerce-datalayer-spec/datalayer.schema.json",
  "title": "E-commerce dataLayer event",
  "type": "object",
  "required": ["event", "ecommerce"],
  "properties": {
    "event": { "enum": ["view_item", "add_to_cart", "begin_checkout", "purchase"] }
  },
  "allOf": [
    {
      "if": { "properties": { "event": { "const": "purchase" } } },
      "then": { "properties": { "ecommerce": { "$ref": "#/$defs/purchaseEcommerce" } } },
      "else": { "properties": { "ecommerce": { "$ref": "#/$defs/ecommerce" } } }
    }
  ],
  "$defs": {
    "item": {
      "type": "object",
      "required": ["item_id", "item_name", "price", "quantity"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "item_name": { "type": "string", "minLength": 1 },
        "price": { "type": "number", "minimum": 0 },
        "quantity": { "type": "integer", "minimum": 1 },
        "item_brand": { "type": "string" },
        "item_category": { "type": "string" },
        "item_variant": { "type": "string" },
        "discount": { "type": "number", "minimum": 0 }
      }
    },
    "ecommerce": {
      "type": "object",
      "required": ["currency", "value", "items"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "value": { "type": "number", "minimum": 0 },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }
      }
    },
    "purchaseEcommerce": {
      "allOf": [
        { "$ref": "#/$defs/ecommerce" },
        {
          "required": ["transaction_id", "tax", "shipping", "new_customer"],
          "properties": {
            "transaction_id": { "type": "string", "minLength": 1 },
            "tax": { "type": "number", "minimum": 0 },
            "shipping": { "type": "number", "minimum": 0 },
            "new_customer": { "enum": ["true", "false", "not_specified"] },
            "coupon": { "type": "string" },
            "payment_type": { "type": "string" }
          }
        }
      ]
    }
  }
}
